<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEMPIC</title>
    <link rel="alternate icon" type="image/png" href="/imgs/Mempic svg.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8fafc; }
        .gradient-bg { background: linear-gradient(135deg, #f43f5e, #2dd4bf); }
        .gradient-text { background: linear-gradient(90deg, #f43f5e, #2dd4bf); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .card { background: white; border-radius: 20px; border: 1px solid #f1f5f9; }
        .avatar-ring { background: linear-gradient(135deg, #f43f5e, #2dd4bf); padding: 3px; border-radius: 50%; }
    </style>
</head>
<body class="min-h-screen">

    
    <nav class="w-full bg-white/80 backdrop-blur-md border-b border-slate-100 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="font-black text-slate-900 text-xl tracking-tight flex items-center gap-2">
                MEMPIC <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
            </a>
            <div class="flex items-center gap-6">
                <a href="/main" class="text-xs font-bold uppercase tracking-wider text-slate-500 hover:text-slate-900 transition-colors">Public Gallery</a>
                <a href="/users/logout" class="bg-slate-900 text-white text-xs font-bold uppercase tracking-widest px-4 py-2.5 rounded-xl hover:bg-slate-800 transition-all active:scale-[0.98]">Logout</a>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto px-6 py-10">

        <!-- Profile Header -->
        <div class="card p-8 mb-6 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-32 gradient-bg opacity-10 rounded-t-[20px]"></div>
            <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center gap-6">
                <!-- Avatar -->
                <div class="avatar-ring flex-shrink-0">
                    <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center text-3xl font-black text-rose-500">
                        <%= locals.user ? user.Fullname.charAt(0).toUpperCase() : 'U' %>
                    </div>
                </div>
                <div class="flex-1">
                    <h1 class="text-2xl font-black text-gray-900">
                        <%= locals.user ? user.Fullname : 'User Name' %>
                    </h1>
                    <p class="text-gray-500 text-sm mt-0.5"><%= locals.user ? user.email : 'email@example.com' %></p>
                    <div class="flex flex-wrap gap-2 mt-3">
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-500 uppercase tracking-wide">
                            <%= locals.user ? user.role : 'user' %>
                        </span>
                        <% if (locals.user && user.club) { %>
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-600">
                                <i class="ri-building-line mr-1"></i><%= user.club %>
                            </span>
                        <% } %>
                        <% if (locals.user && user.isClubMember) { %>
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-500">
                                Club Member
                            </span>
                        <% } %>
                    </div>
                </div>
                <a href="/profile/edit" class="flex-shrink-0 flex items-center gap-2 text-sm font-semibold text-gray-600 bg-gray-50 border border-gray-200 px-4 py-2.5 rounded-xl hover:border-rose-300 hover:text-rose-500 transition">
                    <i class="ri-edit-line"></i> Edit Profile
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Account Details -->
            <div class="card p-6 lg:col-span-1">
                <h2 class="font-bold text-gray-900 text-sm mb-5 flex items-center gap-2">
                    <i class="ri-user-settings-line text-rose-400"></i> Account Details
                </h2>
                <div class="space-y-4">
                    <div>
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Full Name</p>
                        <p class="text-sm font-semibold text-gray-800"><%= locals.user ? user.Fullname : '—' %></p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Email</p>
                        <p class="text-sm font-semibold text-gray-800"><%= locals.user ? user.email : '—' %></p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Role</p>
                        <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-rose-50 text-rose-500 uppercase">
                            <%= locals.user ? user.role : '—' %>
                        </span>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Club Membership</p>
                        <p class="text-sm font-semibold text-gray-800">
                            <% if (locals.user && user.club) { %>
                                <span class="text-teal-600"><i class="ri-checkbox-circle-fill"></i> <%= user.club %></span>
                            <% } else { %>
                                <span class="text-gray-400">Not a club member</span>
                            <% } %>
                        </p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Member Since</p>
                        <p class="text-sm font-semibold text-gray-800">
                            <%= locals.user && user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', {year:'numeric',month:'long',day:'numeric'}) : '—' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Activity / Stats -->
            <div class="card p-6 lg:col-span-2">
                <h2 class="font-bold text-gray-900 text-sm mb-5 flex items-center gap-2">
                    <i class="ri-bar-chart-line text-rose-400"></i> Activity
                </h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
                    <div class="bg-rose-50 rounded-2xl p-4">
                        <p class="text-[10px] font-bold text-rose-400 uppercase tracking-wider mb-1">Uploads</p>
                        <p class="text-2xl font-black text-gray-900"><%= locals.uploadCount || 0 %></p>
                    </div>
                    <div class="bg-teal-50 rounded-2xl p-4">
                        <p class="text-[10px] font-bold text-teal-500 uppercase tracking-wider mb-1">Events</p>
                        <p class="text-2xl font-black text-gray-900"><%= locals.eventCount || 0 %></p>
                    </div>
                    <div class="bg-gray-50 rounded-2xl p-4">
                        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Comments</p>
                        <p class="text-2xl font-black text-gray-900"><%= locals.commentCount || 0 %></p>
                    </div>
                </div>

                <!-- Role-specific actions -->
                <div class="space-y-2">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Quick Actions</p>
                    <% if (locals.user && user.role === 'admin') { %>
                        <a href="/admin" class="flex items-center gap-3 p-3 rounded-xl hover:bg-rose-50 transition group">
                            <div class="w-9 h-9 rounded-xl bg-rose-100 flex items-center justify-center group-hover:bg-rose-200 transition">
                                <i class="ri-dashboard-line text-rose-500"></i>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-800">Admin Panel</p>
                                <p class="text-xs text-gray-400">Manage events and media</p>
                            </div>
                            <i class="ri-arrow-right-s-line ml-auto text-gray-300 group-hover:text-rose-400 transition"></i>
                        </a>
                    <% } %>
                    <% if (locals.user && (user.role === 'photographer' || user.role === 'admin')) { %>
                        <a href="/photographer" class="flex items-center gap-3 p-3 rounded-xl hover:bg-teal-50 transition group">
                            <div class="w-9 h-9 rounded-xl bg-teal-100 flex items-center justify-center group-hover:bg-teal-200 transition">
                                <i class="ri-camera-line text-teal-500"></i>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-800">Upload Media</p>
                                <p class="text-xs text-gray-400">Add photos & videos to events</p>
                            </div>
                            <i class="ri-arrow-right-s-line ml-auto text-gray-300 group-hover:text-teal-400 transition"></i>
                        </a>
                    <% } %>
                    <a href="/main" class="flex items-center gap-3 p-3 rounded-xl hover:bg-gray-50 transition group">
                        <div class="w-9 h-9 rounded-xl bg-gray-100 flex items-center justify-center group-hover:bg-gray-200 transition">
                            <i class="ri-image-2-line text-gray-500"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-800">Browse Gallery</p>
                            <p class="text-xs text-gray-400">View all events and media</p>
                        </div>
                        <i class="ri-arrow-right-s-line ml-auto text-gray-300 group-hover:text-gray-400 transition"></i>
                    </a>
                    <% if (locals.user && user.club) { %>
                        <a href="/members" class="flex items-center gap-3 p-3 rounded-xl hover:bg-blue-50 transition group">
                            <div class="w-9 h-9 rounded-xl bg-blue-100 flex items-center justify-center group-hover:bg-blue-200 transition">
                                <i class="ri-shield-user-line text-blue-500"></i>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-800">Members Gallery</p>
                                <p class="text-xs text-gray-400"><%= user.club %> exclusive content</p>
                            </div>
                            <i class="ri-arrow-right-s-line ml-auto text-gray-300 group-hover:text-blue-400 transition"></i>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- My Media -->
        <% if (locals.myMedia && myMedia.length > 0) { %>
        <div class="card p-6 mt-6">
            <h2 class="font-bold text-gray-900 text-sm mb-5 flex items-center gap-2">
                <i class="ri-gallery-line text-rose-400"></i> My Uploads
            </h2>
            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-3">
            <% myMedia.forEach(media => { %>
                <div class="group relative rounded-xl overflow-hidden bg-gray-100 aspect-square">
                    <% if (media.type === 'video') { %>
                        <div class="w-full h-full bg-gray-900 flex items-center justify-center">
                            <i class="ri-play-circle-line text-white text-2xl"></i>
                        </div>
                    <% } else { %>
                        <img src="<%= media.url %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                    <% } %>
                    <div class="absolute top-1 right-1">
                        <span class="text-[8px] font-bold px-1.5 py-0.5 rounded-full <%= media.visibility === 'public' ? 'bg-teal-500' : 'bg-rose-500' %> text-white">
                            <%= media.visibility === 'public' ? 'P' : 'M' %>
                        </span>
                    </div>
                </div>
            <% }) %>
            </div>
        </div>
        <% } %>

    </div>

</body>
</html>
