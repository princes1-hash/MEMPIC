<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEMPIC</title>
    <script src="https://cdn.tailwindcss.com"></script>
  <link rel="alternate icon" type="image/png" href="/imgs/Mempic svg.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 antialiased selection:bg-rose-100 selection:text-rose-600">
   <%- include('flash') %>
    <div class="fixed top-0 left-0 w-[450px] h-[450px] bg-gradient-to-br from-rose-100/40 to-transparent rounded-full filter blur-3xl pointer-events-none z-0"></div>
    <div class="fixed bottom-0 right-0 w-[450px] h-[450px] bg-gradient-to-tl from-teal-50/40 to-transparent rounded-full filter blur-3xl pointer-events-none z-0"></div>

    <div class="w-full max-w-md bg-white border border-slate-100 rounded-3xl p-8 sm:p-10 shadow-sm relative overflow-hidden z-10 transition-all duration-300 hover:shadow-md">
        
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-rose-100/20 to-transparent rounded-bl-full pointer-events-none"></div>

        <div class="text-center mb-8 relative">
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center justify-center gap-2">
                MEMPIC <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
            </h1>
            <p class="text-slate-400 font-medium text-xs uppercase tracking-widest mt-2">Secure Verification</p>
            <h2 id="portal-title" class="text-xl font-bold text-slate-800 tracking-tight mt-4">Welcome Back, Admin</h2>
        </div>

        <div class="p-1 bg-slate-100 border border-slate-200/40 rounded-2xl flex items-center mb-6 relative z-10">
            <div id="active-bg" class="absolute top-1 bottom-1 left-1 w-[calc(50%-4px)] bg-white rounded-xl shadow-sm border border-slate-200/50 transition-all duration-300 ease-out z-0"></div>
            
            <button type="button" id="btn-admin" onclick="switchPortal('admin')" class="w-1/2 py-2.5 text-xs font-black uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-900 relative z-10">
                <i class="ri-shield-user-fill mr-1 text-sm align-middle"></i> Admin
            </button>
            <button type="button" id="btn-photographer" onclick="switchPortal('photographer')" class="w-1/2 py-2.5 text-xs font-black uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-400 hover:text-slate-700 relative z-10">
                <i class="ri-camera-lens-line mr-1 text-sm align-middle"></i> Photographer
            </button>
        </div>

        <% if (locals.messages && messages.error) { %>
            <div class="mb-6 bg-rose-50 border border-rose-100 rounded-2xl p-4 flex items-start gap-3 text-rose-600 text-xs font-semibold">
                <i class="ri-error-warning-line text-base mt-0.5"></i>
                <span><%= messages.error %></span>
            </div>
        <% } %>

        <form id="loginForm" action="/adminLogin" method="POST" class="space-y-5 relative z-10">
            
            <div>
                <label for="email" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2 px-1">Email</label>
                <div class="relative group">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-rose-500 transition-colors">
                        <i class="ri-mail-line text-lg"></i>
                    </span>
                    <input 
                        type="email" 
                        name="email" 
                        id="email" 
                        required 
                        placeholder="admin@iitr.ac.in"
                        class="w-full bg-slate-50 border border-slate-200/80 rounded-2xl py-3.5 pl-12 pr-4 text-sm text-slate-800 placeholder-slate-400 font-medium outline-none focus:bg-white focus:border-rose-400 focus:ring-4 focus:ring-rose-500/5 transition-all duration-200 shadow-inner"
                    >
                </div>
            </div>

            <div>
                <div class="flex items-center justify-between mb-2 px-1">
                    <label for="password" class="block text-xs font-bold text-slate-400 uppercase tracking-widest">Your Password</label>
                    <a href="/forgot-password" class="text-xs font-bold text-rose-500 hover:text-rose-600 transition-colors tracking-wide">Forgot Access?</a>
                </div>
                <div class="relative group">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-rose-500 transition-colors">
                        <i class="ri-lock-line text-lg"></i>
                    </span>
                    <input 
                        type="password" 
                        name="password" 
                        id="password" 
                        required 
                        placeholder="••••••••"
                        class="w-full bg-slate-50 border border-slate-200/80 rounded-2xl py-3.5 pl-12 pr-12 text-sm text-slate-800 placeholder-slate-400 font-medium outline-none focus:bg-white focus:border-rose-400 focus:ring-4 focus:ring-rose-500/5 transition-all duration-200 shadow-inner"
                    >
                    <button type="button" onclick="togglePassword()" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors focus:outline-none">
                        <i id="eye-icon" class="ri-eye-line text-lg"></i>
                    </button>
                </div>
            </div>

            <div class="flex items-center gap-2 px-1 pt-1">
                <input 
                    type="checkbox" 
                    id="remember" 
                    name="remember" 
                    class="w-4 h-4 rounded-md border-slate-200 text-rose-400 focus:ring-rose-500/20 accent-rose-500 cursor-pointer transition-all"
                >
                <label for="remember" class="text-xs font-bold text-slate-500 select-none cursor-pointer tracking-wide">Save Your session</label>
            </div>

            <button 
                type="submit" 
                id="submit-btn"
                class="w-full mt-2 bg-slate-700 text-white rounded-2xl py-4 text-xs font-bold uppercase tracking-widest hover:bg-teal-400 active:scale-[0.99] focus:outline-none focus:ring-4 focus:ring-slate-900/10 transition-all duration-200 shadow-sm"
            >
                Login as Admin
            </button>
        </form>

        <div class="mt-8 text-center relative z-10">
            <p class="text-xs font-semibold text-slate-400 tracking-wide">
                External User? <a href="/main" class="text-slate-900 font-bold hover:underline transition-all">Return to Public View Grid</a>
            </p>
        </div>

    </div>

    <script>
        function switchPortal(role) {
            const form = document.getElementById('loginForm');
            const title = document.getElementById('portal-title');
            const emailInput = document.getElementById('email');
            const submitBtn = document.getElementById('submit-btn');
            
            const btnAdmin = document.getElementById('btn-admin');
            const btnPhoto = document.getElementById('btn-photographer');
            const activeBg = document.getElementById('active-bg');

            if (role === 'admin') {
                activeBg.style.transform = 'translateX(0)';
                form.action = '/adminLogin';
                title.textContent = 'Welcome Back, Admin';
                emailInput.placeholder = 'admin@iitr.ac.in';
                submitBtn.textContent = 'Login as Admin';
                btnAdmin.className = "w-1/2 py-2.5 text-xs font-black uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-900 relative z-10";
                btnPhoto.className = "w-1/2 py-2.5 text-xs font-black uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-400 hover:text-slate-700 relative z-10";
                
                btnAdmin.querySelector('i').className = 'ri-shield-user-fill mr-1 text-sm align-middle';
                btnPhoto.querySelector('i').className = 'ri-camera-lens-line mr-1 text-sm align-middle';
            } else if (role === 'photographer') {
                activeBg.style.transform = 'translateX(100%)';
                form.action = '/photographerLogin';
                title.textContent = 'Welcome Back, Photographer';
                emailInput.placeholder = 'lens@iitr.ac.in';
                submitBtn.textContent = 'Login as Photographer';

                btnPhoto.className = "w-1/2 py-2.5 text-xs font-black uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-900 relative z-10";
                btnAdmin.className = "w-1/2 py-2.5 text-xs font-black uppercase tracking-wider rounded-xl transition-all duration-200 text-slate-400 hover:text-slate-700 relative z-10";
                
                btnPhoto.querySelector('i').className = 'ri-camera-lens-fill mr-1 text-sm text-teal-500 align-middle';
                btnAdmin.querySelector('i').className = 'ri-shield-user-line mr-1 text-sm align-middle';
            }
        }

        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eye-icon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.className = 'ri-eye-off-line text-lg';
            } else {
                passwordInput.type = 'password';
                eyeIcon.className = 'ri-eye-line text-lg';
            }
        }
    </script>
</body>
</html>