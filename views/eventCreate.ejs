<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEMPIC</title>
    <link rel="alternate icon" type="image/png" href="/imgs/Mempic svg.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.7.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8fafc; }
        .gradient-bg { background: linear-gradient(90deg, #f43f5e, #2dd4bf); }
        .gradient-text { background: linear-gradient(90deg, #f43f5e, #2dd4bf); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .input-field {
            width: 100%; padding: 10px 14px; background: #f9fafb;
            border: 1px solid #e5e7eb; border-radius: 10px; font-size: 14px;
            outline: none; transition: all .2s;
        }
        .input-field:focus { border-color: #f43f5e; background: white; box-shadow: 0 0 0 3px rgba(244,63,94,0.08); }
        .preview-img { width: 80px; height: 80px; object-fit: cover; border-radius: 10px; border: 2px solid #e5e7eb; }
        .drag-zone {
            border: 2px dashed #e5e7eb; border-radius: 14px; padding: 28px;
            text-align: center; transition: all .2s; cursor: pointer;
        }
        .drag-zone:hover, .drag-zone.dragover { border-color: #f43f5e; background: #fff1f2; }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center p-6 sm:p-12">
   <%- include('flash') %>
    <div class="w-full max-w-3xl">
        <div class="mb-6 flex items-center justify-between">
            <a href="/admin" class="text-sm font-semibold text-gray-500 hover:text-rose-500 flex items-center gap-1.5 transition">
                <i class="ri-arrow-left-line"></i> Back to Dashboard
            </a>
            <span class="text-xs font-bold text-gray-400 bg-gray-100 rounded-lg px-2.5 py-1 uppercase">ID: <%= event._id %></span>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
            <div class="flex items-center gap-3 mb-8">
                <div class="w-10 h-10 rounded-xl gradient-bg flex items-center justify-center">
                    <i class="ri-edit-box-line text-white text-lg"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-gray-900">Modify Event Manifest</h2>
                    <p class="text-xs text-gray-500">Update target metadata properties, access layers or adjust asset media allocations</p>
                </div>
            </div>

            <form method="POST" action="/admin/create/event" enctype="multipart/form-data" class="space-y-6">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Event Name *</label>
                        <input type="text" name="eventName" value="<%= event.eventName %>" placeholder="e.g. THOMSO Night 2025" class="input-field" required>
                    </div>
                  <div class="mb-5">
    <label for="club" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 px-1">
        Associated Club
    </label>
    <div class="relative group">
       
        
<% if (user.role === "admin") { %>

    <select 
        name="club"
        id="club"
        class="w-full bg-slate-50 border border-slate-200 rounded-2xl py-3.5 pl-12 pr-10 text-sm font-semibold text-slate-700 outline-none appearance-none"
        required
    >
        <option value="" disabled selected>-- Select Associated Club --</option>

        <% 
            const clubsList = ["COGNIZANCE", "THOMSO", "MARS", "CIG", "SDSLabs", "UBA", "SocBiz", "BlocSoc"];
            clubsList.forEach(c => {
        %>
            <option value="<%= c %>"><%= c %></option>
        <% }) %>
    </select>

<% } else if (user.role === "photographer") { %>

    <input
        type="text"
        value="<%= user.club %>"
        class="w-full bg-slate-100 border border-slate-200 rounded-2xl py-3.5 px-4 text-sm font-semibold text-slate-700"
        readonly
    >

    <input
        type="hidden"
        name="club"
        value="<%= user.club %>"
    >

<% } %>
        
        <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-rose-500 transition-colors pointer-events-none">
            <i class="ri-arrow-down-s-line text-lg"></i>
        </span>
    </div>
</div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Event Date *</label>
                        <input type="date" name="eventDate" value="<%= event.eventDate ? new Date(event.eventDate).toISOString().split('T') : '' %>" class="input-field" required>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Event Time</label>
                        <input type="time" name="eventTime" value="<%= event.eventTime %>" class="input-field">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Venue / Location</label>
                        <input type="text" name="venue" value="<%= event.venue %>" placeholder="e.g. Open Air Theatre, IIT Roorkee" class="input-field">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Event Category</label>
                        <select name="category" class="input-field">
                            <% const cats = ["cultural", "PhotoShoot","Farewell","Chapoo","Trip","technical", "sports", "workshop", "fest", "other"]; %>
                            <% cats.forEach(cat => { %>
                                <option value="<%= cat %>" <%= event.category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-2">Event Description</label>
                    <textarea name="description" rows="3" placeholder="Describe the event structural context..." class="input-field resize-none"><%= event.description %></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-2">Event Visibility Layer</label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-2 cursor-pointer text-sm text-gray-600 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 hover:border-rose-300 transition">
                            <input type="radio" name="visibility" value="public" <%= event.visibility === 'public' ? 'checked' : '' %> class="accent-rose-500">
                            <span class="font-medium">Public</span>
                            <span class="text-xs text-gray-400">— global index ecosystem transparency</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer text-sm text-gray-600 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 hover:border-rose-300 transition">
                            <input type="radio" name="visibility" value="members" <%= event.visibility === 'members' ? 'checked' : '' %> class="accent-rose-500">
                            <span class="font-medium">Members Only</span>
                            <span class="text-xs text-gray-400">— active internal group limitation</span>
                        </label>
                    </div>
                </div>

               
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Tags (comma separated)</label>
                        <input type="text" name="tags" value="<%= event.tags ? event.tags.join(', ') : '' %>" placeholder="photography, night, cultural" class="input-field">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Max Photographers Allowed</label>
                        <input type="number" name="maxPhotographers" min="1" max="50" value="<%= event.maxPhotographers || 5 %>" class="input-field w-full">
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                    <button type="submit" class="gradient-bg text-white font-semibold py-3 px-8 rounded-xl hover:opacity-90 transition flex items-center gap-2 shadow-lg shadow-rose-100">
                        <i class="ri-save-3-line"></i> Save Document Changes
                    </button>
                    <a href="/admin" class="bg-gray-100 text-gray-600 font-semibold py-3 px-6 rounded-xl hover:bg-gray-200 text-sm transition">
                        Cancel Changes
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function previewCover(event) {
            const file = event.target.files;
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                const wrap = document.getElementById('coverPreviewWrap');
                wrap.innerHTML = `<img src="${e.target.result}" class="mx-auto max-h-32 rounded-xl object-cover shadow">
                    <p class="text-xs text-teal-500 mt-2 font-medium">✓ Ready to stage: ${file.name}</p>`;
            };
            reader.readAsDataURL(file);
        }

        // Setup drop-zone listeners
        const el = document.getElementById('coverDrop');
        el.addEventListener('dragover', e => { e.preventDefault(); el.classList.add('dragover'); });
        el.addEventListener('dragleave', () => el.classList.remove('dragover'));
        el.addEventListener('drop', e => {
            e.preventDefault(); el.classList.remove('dragover');
            const input = document.getElementById('coverInput');
            if (input && e.dataTransfer.files.length) {
                input.files = e.dataTransfer.files;
                input.dispatchEvent(new Event('change'));
            }
        });
    </script>
</body>
</html>