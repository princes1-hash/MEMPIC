    <script>
        
// document.addEventListener('visibilitychange', () => {
//     if (document.visibilityState === 'visible') {
//         window.location.reload(); 
//     }
// });

const socket = io();

let loggedInSessionUserId = "";
try {
    <% if (locals.user) { %>
        loggedInSessionUserId = "<%= user._id || user.id || '' %>";
    <% } %>
} catch(e) {
    console.error("EJS parsing error checking active session variables", e);
}

if (loggedInSessionUserId) {
    socket.emit('register-user-session', loggedInSessionUserId);
}

socket.on('incoming-notification', (notif) => {

    const unreadDot = document.getElementById('nav-unread-dot');
    if (unreadDot) {
        unreadDot.classList.remove('hidden');
    }

    const drawer = document.getElementById('notification-drawer');
    const isDrawerOpen = drawer && !drawer.classList.contains('translate-x-full');

    if (isDrawerOpen) {
        renderCardElementInFeedView(notif, true);
    } else {
        const countBadge = document.getElementById('notification-badge-count');
        if (countBadge) {
            countBadge.innerText = parseInt(countBadge.innerText || 0) + 1;
        }

        createFloatingToastAlert(notif);
    }
});

function createFloatingToastAlert(notif) {
    const toast = document.createElement('div');
    
    toast.className = "fixed bottom-5 right-5 z-50 bg-white/95 backdrop-blur-md border border-slate-200/80 rounded-2xl p-4 flex items-start gap-3 max-w-sm transition-all duration-500 transform translate-y-10 opacity-0 shadow-2xl";
    toast.style.boxShadow = "0 20px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.08)";
    
    let iconClass = "ri-chat-3-line text-slate-500";
    if (notif.type === 'like') iconClass = "ri-heart-3-line text-rose-500";
    if (notif.type === 'system') iconClass = "ri-sparkling-line text-amber-500";

    toast.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center shrink-0 shadow-xs">
            <i class="${iconClass} text-sm"></i>
        </div>
        <div class="flex-1 min-w-0">
            <h4 class="text-xs font-bold text-slate-800 truncate">${notif.title || 'System Update'}</h4>
            <p class="text-[11px] text-slate-500 font-medium mt-0.5 leading-relaxed break-words">${notif.message}</p>
        </div>
        <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 transition-colors shrink-0 pl-1">
            <i class="ri-close-line text-base"></i>
        </button>
    `;

    document.body.appendChild(toast);

    setTimeout(() => {
        toast.classList.remove('translate-y-10', 'opacity-0');
    }, 50);

    setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 500);
    }, 5500);
}

async function toggleNotificationDrawer() {
    const drawer = document.getElementById('notification-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const isHidden = drawer.classList.contains('translate-x-full');

    if (isHidden) {
        await syncNotificationDataHistory();
        drawer.classList.remove('translate-x-full');
        if (overlay) {
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.add('opacity-100'), 10);
        }
        const unreadDot = document.getElementById('nav-unread-dot');
        if (unreadDot) unreadDot.classList.add('hidden');
    } else {
        drawer.classList.add('translate-x-full');
        if (overlay) {
            overlay.classList.remove('opacity-100');
            setTimeout(() => overlay.classList.add('hidden'), 300);
        }
        
        fetch('/api/notifications/mark-read', { method: 'POST' });
    }
    
}

async function syncNotificationDataHistory() {
    try {
        const res = await fetch('/api/notifications');
        const data = await res.json();
        
        const feed = document.getElementById('notification-feed-container');
        if (!feed) return;
        
        feed.innerHTML = '';
        
        if (data.success && data.notifications && data.notifications.length > 0) {
            let unreadCount = 0;
            data.notifications.forEach(notif => {
                if(!notif.isRead) unreadCount++;
                renderCardElementInFeedView(notif, false);
            });
            const countBadge = document.getElementById('notification-badge-count');
            if (countBadge) countBadge.innerText = unreadCount;
        } else {
            feed.innerHTML = `
                <div id="notification-empty-state" class="h-full flex flex-col items-center justify-center text-center p-6">
                    <div class="w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-300 mb-3">
                        <i class="ri-notification-off-line text-xl"></i>
                    </div>
                    <p class="text-xs font-bold text-slate-700">All caught up!</p>
                </div>`;
            const countBadge = document.getElementById('notification-badge-count');
            if (countBadge) countBadge.innerText = 0;
        }
    } catch (err) {
        console.error("Critical issue fetching system alert arrays:", err);
    }
}

function renderCardElementInFeedView(notif, isPrependAction = false) {
    const feed = document.getElementById('notification-feed-container');
    if (!feed) return;

    const emptyState = document.getElementById('notification-empty-state');
    if (emptyState) emptyState.remove();

    const card = document.createElement('div');
    card.className = `w-full p-3 rounded-xl flex gap-3 items-start transition-all duration-200 ${notif.isRead ? 'bg-white border border-slate-100/60' : 'bg-slate-50 border border-slate-100 shadow-xs animate-fadeInItem'}`;
    
    let iconClass = "ri-chat-3-line";
    if (notif.type === 'like') iconClass = "ri-heart-3-line text-rose-400";
    if (notif.type === 'system') iconClass = "ri-sparkling-line text-amber-500";

    card.innerHTML = `
        <div class="w-7 h-7 rounded-lg bg-white border border-slate-200/60 flex items-center justify-center shrink-0 shadow-xs">
            <i class="${iconClass} text-xs"></i>
        </div>
        <div class="flex-1 min-w-0">
            <h4 class="text-xs font-bold text-slate-800 truncate">${notif.title || 'Notification'}</h4>
            <p class="text-[11px] text-slate-500 font-medium mt-0.5 leading-relaxed break-words">${notif.message}</p>
        </div>
    `;

    if (isPrependAction) {
        feed.insertBefore(card, feed.firstChild);
    } else {
        feed.appendChild(card);
    }
}

async function clearAllNotifications() {
    try {
        const res = await fetch('/api/notifications/clear', { method: 'DELETE' });
        const data = await res.json();
        if(data.success) {
            await syncNotificationDataHistory();
        }
    } catch (err) {
        console.error("Error clearing notifications:", err);
    }
}


