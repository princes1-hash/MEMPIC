<div id="notification-drawer" 
     class="fixed top-0 right-0 h-full w-full sm:w-96 bg-white/80 backdrop-blur-xl border-l border-slate-200/60 shadow-2xl z-50 translate-x-full transition-transform duration-300 ease-out flex flex-col font-sans">
    
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-slate-900">Notifications</h3>
            <span id="notification-badge-count" class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-full">0</span>
        </div>
        <button onclick="toggleNotificationDrawer()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-50 transition-all focus:outline-none">
            <i class="ri-close-line text-lg"></i>
        </button>
    </div>

    <div id="notification-feed-container" class="flex-1 overflow-y-auto p-4 space-y-3">
        
        <div id="notification-empty-state" class="h-full flex flex-col items-center justify-center text-center p-6">
            <div class="w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-300 mb-3">
                <i class="ri-notification-off-line text-xl"></i>
            </div>
            <p class="text-xs font-bold text-slate-700">All caught up!</p>
            <p class="text-[11px] text-slate-400 mt-0.5 max-w-[180px]">New interactions and updates will appear here in real time.</p>
        </div>

    </div>

    <div class="p-4 border-t border-slate-100 bg-slate-50/50">
        <button onclick="clearAllNotifications()" class="w-full py-2 bg-slate-100 hover:bg-slate-200/80 text-slate-600 text-xs font-bold rounded-xl transition-colors focus:outline-none">
            Clear All
        </button>
    </div>
</div>

<div id="drawer-overlay" onclick="toggleNotificationDrawer()" class="fixed inset-0 bg-slate-950/20 backdrop-blur-xs z-40 hidden opacity-0 transition-opacity duration-300"></div>

<style>
    @keyframes feedNotificationItemFadeIn {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeInItem {
        animation: feedNotificationItemFadeIn 0.22s ease-out forwards;
    }
</style>