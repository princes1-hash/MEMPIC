<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEMPIC</title>
    <link rel="alternate icon" type="image/png" href="/imgs/Mempic svg.svg"> 
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gradient-brand { background: linear-gradient(135deg, #f43f5e 0%, #2dd4bf 100%); }
        .gradient-btn { background: linear-gradient(90deg, #f43f5e 0%, #2dd4bf 100%); }
        input[type="radio"]:checked + label {
            border-color: #f43f5e;
            background-color: #fff1f2;
            color: #f43f5e;
        }
        .club-section { display: none; }
        .club-section.visible { display: block; }
        .input-field {
            width: 100%; padding: 10px 16px 10px 40px;
            background: rgba(249,250,251,0.5); border: 1px solid #e5e7eb;
            border-radius: 12px; font-size: 14px; transition: all .2s;
            outline: none;
        }
        .input-field:focus { border-color: #f43f5e; background: white; box-shadow: 0 0 0 3px rgba(244,63,94,0.08); }
        select.input-field { padding-left: 12px; }
    </style>
</head>
<body class="bg-[#f0f4f8] min-h-screen flex items-center justify-center p-4 sm:p-6 md:p-12 antialiased">
   <%- include('flash') %>
    <main class="w-full max-w-5xl bg-white rounded-[2rem] shadow-2xl overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[700px]">
        <section class="md:col-span-5 bg-slate-900 p-8 lg:p-12 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <div class="absolute -right-20 -top-20 w-60 h-60 bg-teal-500 rounded-full blur-[100px] opacity-20"></div>
            <div class="absolute -left-20 -bottom-20 w-60 h-60 bg-rose-500 rounded-full blur-[100px] opacity-20"></div>

            <div class="relative z-10 flex items-center space-x-2.5">
                <div class="w-9 h-9 rounded-xl gradient-brand flex items-center justify-center shadow-md">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <span class="text-xl font-black text-white tracking-tight">MEMPIC</span>
            </div>

            <div class="relative z-10 my-12 md:my-0">
                <h1 class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15] mb-4">
                    The Hub of<br>
                    <span class="text-rose-400">Event Media.</span>
                </h1>
                <p class="text-slate-400 text-sm lg:text-base leading-relaxed max-w-sm">
                    Join the central ecosystem for event photography and premium media management for clubs across campus.
                </p>
            </div>

            <div class="relative z-10 grid grid-cols-2 gap-4">
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                    <span class="block text-[10px] font-bold text-rose-400 tracking-wider uppercase mb-1">Active Events</span>
                    <span class="text-xl font-bold text-white tracking-tight">1,000+</span>
                </div>
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                    <span class="block text-[10px] font-bold text-teal-400 tracking-wider uppercase mb-1">Media Assets</span>
                    <span class="text-xl font-bold text-white tracking-tight">2.2M</span>
                </div>
            </div>
        </section>

        <!-- Right Form Panel -->
        <section class="md:col-span-7 p-8 lg:p-12 flex flex-col justify-center overflow-y-auto">
            <div class="max-w-md mx-auto w-full">
                <div class="mb-7">
                    <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 tracking-tight mb-1">Create Account</h2>
                    <p class="text-sm text-gray-500">Fill in your details to join MEMPIC.</p>
                </div>

                <form method="post" action="/users/register" class="space-y-5">

                    <!-- Name + Email -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Full Name</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400 pointer-events-none">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                </span>
                                <input type="text" name="Fullname" placeholder="Your full name" class="input-field" required>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Email Address</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400 pointer-events-none">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                </span>
                                <input type="email" name="email" placeholder="you@email.com" class="input-field" required>
                            </div>
                        </div>
                    </div>

                    <!-- Password + Confirm -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Password</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400 pointer-events-none">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zM10 11V7a2 2 0 114 0v4"/></svg>
                                </span>
                                <input type="password" name="password" placeholder="••••••••" class="input-field" required>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Confirm Password</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400 pointer-events-none">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                </span>
                                <input type="password" name="confirmPass" placeholder="••••••••" class="input-field" required>
                            </div>
                        </div>
                    </div>

                    <!-- Role -->
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-2">Your Role</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                            <div>
                                <input type="radio" name="role" id="role-user" value="user" class="hidden" checked>
                                <label for="role-user" class="flex flex-col items-center justify-center p-3 border border-gray-200 bg-gray-50/50 rounded-xl cursor-pointer text-center text-gray-500 hover:bg-gray-50 hover:border-gray-300 transition">
                                    <svg class="w-5 h-5 text-rose-400 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    <span class="text-[11px] font-medium">Viewer</span>
                                </label>
                            </div>
                            <div>
                                <input type="radio" name="role" id="role-photog" value="photographer" class="hidden">
                                <label for="role-photog" class="flex flex-col items-center justify-center p-3 border border-gray-200 bg-gray-50/50 rounded-xl cursor-pointer text-center text-gray-500 hover:bg-gray-50 hover:border-gray-300 transition">
                                    <svg class="w-5 h-5 text-rose-400 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    <span class="text-[11px] font-medium">Photographer</span>
                                </label>
                            </div>
                            <div>
                                <input type="radio" name="role" id="role-member" value="member" class="hidden">
                                <label for="role-member" class="flex flex-col items-center justify-center p-3 border border-gray-200 bg-gray-50/50 rounded-xl cursor-pointer text-center text-gray-500 hover:bg-gray-50 hover:border-gray-300 transition">
                                    <svg class="w-5 h-5 text-rose-400 mb-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                                    <span class="text-[11px] font-medium">Member</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Club Membership Question -->
                    <div class="bg-rose-50/60 border border-rose-100 rounded-2xl p-4 space-y-3">
                        <p class="text-xs font-semibold text-gray-700">Are you a part of a club?</p>
                        <div class="flex gap-4">
                            <label class="flex items-center gap-2 cursor-pointer text-sm text-gray-600">
                                <input type="radio" name="isClubMember" id="club-yes" value="yes" class="accent-rose-500" onchange="toggleClub(true)">
                                <span>Yes</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer text-sm text-gray-600">
                                <input type="radio" name="isClubMember" id="club-no" value="no" value="no" checked class="accent-rose-500" onchange="toggleClub(false)">
                                <span>No</span>
                            </label>
                        </div>

                        <div id="clubDropdownWrapper" class="club-section">
                            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Select Your Club</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400 pointer-events-none">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                </span>
                                <select name="club" class="input-field" style="padding-left:40px;">
                                    <option value="">-- Choose a Club --</option>
                                    <option value="COGNIZANCE">COGNIZANCE</option>
                                    <option value="THOMSO">THOMSO</option>
                                    <option value="MARS">MARS</option>
                                    <option value="CIG">CIG</option>
                                    <option value="SDSLabs">SDSLabs</option>
                                    <option value="UBA">UBA</option>
                                    <option value="SocBiz">SocBiz</option>
                                    <option value="BlocSoc">BlocSoc</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Terms -->
                    <div class="flex items-start">
                        <input id="terms" type="checkbox" required class="w-4 h-4 mt-0.5 border border-gray-300 rounded bg-gray-50 accent-rose-500">
                        <label for="terms" class="ml-2 text-xs text-gray-500 leading-tight">
                            I agree to the <a href="#" class="text-teal-600 hover:underline">Terms of Service</a> and <a href="#" class="text-teal-600 hover:underline">Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="w-full gradient-btn text-white font-semibold py-3 px-4 rounded-xl shadow-lg hover:opacity-95 transition-all flex items-center justify-center gap-2 text-sm group">
                        <span>Create Account</span>
                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>
                </form>

                <div class="mt-6 text-center text-xs text-gray-500">
                    Already have an account? <a href="/users/login" class="text-rose-500 font-semibold hover:underline">Sign In</a>
                </div>
            </div>
        </section>
    </main>

    <script>
        function toggleClub(show) {
            const el = document.getElementById('clubDropdownWrapper');
            el.classList.toggle('visible', show);
        }
    </script>
</body>
</html>
